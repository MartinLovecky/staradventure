{
    "name": "mlkali/sa",
    "description": "Personal website for my story",
    "type": "project",
    "require": {
        "symfony/var-dumper": "^6.2",
        "eftec/bladeone": "^4.0",
        "phpmailer/phpmailer": "^6.8",
        "vlucas/phpdotenv": "^5.5",
        "envms/fluentpdo": "^2.2",
        "league/container": "^4.0",
        "voku/html-min": "^4.0"
    },
    "require-dev": {
        "roave/security-advisories": "dev-latest"
    },
    "license": "none",
    "autoload": {
        "psr-4": {
            "Mlkali\\Sa\\": "src/"
        }
    },
    "authors": [
        {
            "name": "MartinLovecky",
            "email": "mlovecky@seznam.cz"
        }
    ],
    "minimum-stability": "dev",
    "prefer-stable": true,
    "scripts": {
        "lint": "phpcs --standard=PSR12 src",
        "fix": "phpcbf --standard=PSR12 src",
        "test": "phpunit tests"
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist"
    }
}